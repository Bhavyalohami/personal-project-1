rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function signedUserExists() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function signedUser() {
      return get(userPath(request.auth.uid)).data;
    }

    function tokenIsAdmin() {
      return signedIn() &&
        (request.auth.token.admin == true || request.auth.token.role == "admin");
    }

    function profileIsAdmin() {
      return signedUserExists() &&
        (
          signedUser().role == "admin" ||
          signedUser().is_superuser == true ||
          (
            signedUser().roles is list &&
            signedUser().roles.hasAny(["admin"])
          )
        );
    }

    function isAdmin() {
      return tokenIsAdmin() || profileIsAdmin();
    }

    function isSelfPatientSignup(uid) {
      return signedIn() &&
        request.auth.uid == uid &&
        request.resource.data.uid == uid &&
        request.resource.data.roles is list &&
        request.resource.data.roles.hasOnly(["patient"]) &&
        request.resource.data.is_superuser == false &&
        request.resource.data.is_staff == false &&
        request.resource.data.is_vendor == false &&
        !request.resource.data.keys().hasAny([
          "role",
          "permissions",
          "hospitalIds"
        ]);
    }

    function isSelfUsernameCreate() {
      return signedIn() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.roles is list &&
        request.resource.data.roles.hasOnly(["patient"]);
    }

    function memberPath(hospitalId, uid) {
      return /databases/$(database)/documents/hospitals/$(hospitalId)/members/$(uid);
    }

    function isHospitalMember(hospitalId) {
      return signedIn() &&
        (
          isAdmin() ||
          (
            exists(memberPath(hospitalId, request.auth.uid)) &&
            get(memberPath(hospitalId, request.auth.uid)).data.active == true
          )
        );
    }

    function memberData(hospitalId) {
      return get(memberPath(hospitalId, request.auth.uid)).data;
    }

    function hasPermission(hospitalId, module, action) {
      return isAdmin() ||
        (
          isHospitalMember(hospitalId) &&
          memberData(hospitalId).permissions is map &&
          module in memberData(hospitalId).permissions.keys() &&
          memberData(hospitalId).permissions[module] is list &&
          memberData(hospitalId).permissions[module].hasAny([action])
        );
    }

    function isAppointmentParticipant() {
      return signedIn() &&
        (
          resource.data.patientUid == request.auth.uid ||
          resource.data.doctorUid == request.auth.uid
        );
    }

    function isNewAppointmentParticipant() {
      return signedIn() &&
        (
          request.resource.data.patientUid == request.auth.uid ||
          request.resource.data.doctorUid == request.auth.uid
        );
    }

    match /roles/{roleId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /permissions/{permissionId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if isAdmin() || isSelfUsernameCreate();
      allow update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin() || isSelfPatientSignup(uid);
      allow delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == uid &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "role",
          "roles",
          "permissions",
          "hospitalIds",
          "is_superuser",
          "is_staff",
          "is_vendor"
        ])
      );
    }

    match /hospitals/{hospitalId} {
      allow read: if resource.data.public == true ||
        resource.data.status == "active" ||
        isHospitalMember(hospitalId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || hasPermission(hospitalId, "hospital", "update");

      match /members/{uid} {
        allow read: if isAdmin() ||
          (signedIn() && request.auth.uid == uid) ||
          hasPermission(hospitalId, "staff", "view");
        allow create, update, delete: if isAdmin() || hasPermission(hospitalId, "staff", "update");
      }

      match /staff/{staffId} {
        allow read: if isHospitalMember(hospitalId) || resource.data.public == true;
        allow create: if isAdmin() || hasPermission(hospitalId, "staff", "create");
        allow update: if isAdmin() || hasPermission(hospitalId, "staff", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "staff", "delete");
      }

      match /doctors/{doctorId} {
        allow read: if resource.data.public == true || isHospitalMember(hospitalId);
        allow create: if isAdmin() || hasPermission(hospitalId, "staff", "create");
        allow update: if isAdmin() ||
          hasPermission(hospitalId, "staff", "update") ||
          (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isAdmin() || hasPermission(hospitalId, "staff", "delete");
      }

      match /media/{mediaId} {
        allow read: if resource.data.public == true || isHospitalMember(hospitalId);
        allow create: if isAdmin() || hasPermission(hospitalId, "media", "create");
        allow update: if isAdmin() || hasPermission(hospitalId, "media", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "media", "delete");
      }

      match /services/{serviceId} {
        allow read: if resource.data.public == true || isHospitalMember(hospitalId);
        allow create: if isAdmin() || hasPermission(hospitalId, "hospital", "update");
        allow update: if isAdmin() || hasPermission(hospitalId, "hospital", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "hospital", "delete");
      }

      match /tests/{testId} {
        allow read: if resource.data.public == true || isHospitalMember(hospitalId);
        allow create: if isAdmin() || hasPermission(hospitalId, "tests", "create");
        allow update: if isAdmin() || hasPermission(hospitalId, "tests", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "tests", "delete");
      }

      match /testSlots/{slotId} {
        allow read: if resource.data.public == true || isHospitalMember(hospitalId);
        allow create: if isAdmin() || hasPermission(hospitalId, "tests", "create");
        allow update: if isAdmin() || hasPermission(hospitalId, "tests", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "tests", "delete");
      }

      match /patients/{patientId} {
        allow read: if isAdmin() ||
          hasPermission(hospitalId, "patients", "view") ||
          (signedIn() && resource.data.uid == request.auth.uid);
        allow create: if isAdmin() ||
          hasPermission(hospitalId, "patients", "create") ||
          (signedIn() && request.resource.data.uid == request.auth.uid);
        allow update: if isAdmin() ||
          hasPermission(hospitalId, "patients", "update") ||
          (signedIn() && resource.data.uid == request.auth.uid);
        allow delete: if isAdmin() || hasPermission(hospitalId, "patients", "delete");
      }

      match /appointments/{appointmentId} {
        allow read: if isAppointmentParticipant() ||
          hasPermission(hospitalId, "appointments", "view");
        allow create: if isNewAppointmentParticipant() ||
          hasPermission(hospitalId, "appointments", "create");
        allow update: if isAppointmentParticipant() ||
          hasPermission(hospitalId, "appointments", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "appointments", "delete");
      }

      match /inventory/{medicineId} {
        allow read: if hasPermission(hospitalId, "inventory", "view");
        allow create: if hasPermission(hospitalId, "inventory", "create");
        allow update: if hasPermission(hospitalId, "inventory", "update");
        allow delete: if hasPermission(hospitalId, "inventory", "delete");

        match /stockLogs/{logId} {
          allow read: if hasPermission(hospitalId, "inventory", "view");
          allow create: if hasPermission(hospitalId, "inventory", "update");
          allow update, delete: if false;
        }
      }

      match /billing/{invoiceId} {
        allow read: if isAdmin() ||
          hasPermission(hospitalId, "billing", "view") ||
          (signedIn() && resource.data.patientUid == request.auth.uid);
        allow create: if hasPermission(hospitalId, "billing", "create");
        allow update: if hasPermission(hospitalId, "billing", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "billing", "delete");
      }

      match /emr/{recordId} {
        allow read: if isAdmin() ||
          hasPermission(hospitalId, "emr", "view") ||
          (signedIn() && resource.data.patientUid == request.auth.uid);
        allow create: if hasPermission(hospitalId, "emr", "create");
        allow update: if hasPermission(hospitalId, "emr", "update");
        allow delete: if isAdmin() || hasPermission(hospitalId, "emr", "delete");
      }

      match /prescriptions/{prescriptionId} {
        allow read: if isAdmin() ||
          hasPermission(hospitalId, "emr", "view") ||
          (signedIn() && resource.data.patientUid == request.auth.uid) ||
          (signedIn() && resource.data.doctorUid == request.auth.uid);
        allow create, update: if hasPermission(hospitalId, "emr", "update") ||
          (signedIn() && request.resource.data.doctorUid == request.auth.uid);
        allow delete: if isAdmin() || hasPermission(hospitalId, "emr", "delete");
      }

      match /alerts/{alertId} {
        allow read, update: if isAdmin() || isHospitalMember(hospitalId);
        allow create, delete: if isAdmin();
      }

      match /auditLogs/{auditId} {
        allow read: if isAdmin() || hasPermission(hospitalId, "reports", "view");
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read, update: if isAdmin() ||
          hasPermission(hospitalId, "notifications", "view") ||
          (
            signedIn() &&
            (
              resource.data.userUid == request.auth.uid ||
              resource.data.patientUid == request.auth.uid ||
              resource.data.doctorUid == request.auth.uid
            )
          );
        allow create: if isAdmin() || hasPermission(hospitalId, "notifications", "create");
        allow delete: if isAdmin() || hasPermission(hospitalId, "notifications", "delete");
      }

      match /chats/{chatId} {
        function chatParticipant() {
          return signedIn() &&
            (
              resource.data.patientUid == request.auth.uid ||
              resource.data.doctorUid == request.auth.uid
            );
        }

        function newChatPatient() {
          return signedIn() && request.resource.data.patientUid == request.auth.uid;
        }

        allow read: if chatParticipant() || hasPermission(hospitalId, "messages", "view");
        allow create: if newChatPatient() || hasPermission(hospitalId, "messages", "create");
        allow update: if chatParticipant() || hasPermission(hospitalId, "messages", "update");
        allow delete: if isAdmin();

        match /messages/{messageId} {
          function parentChat() {
            return get(/databases/$(database)/documents/hospitals/$(hospitalId)/chats/$(chatId)).data;
          }

          function messageParticipant() {
            return signedIn() &&
              (
                parentChat().patientUid == request.auth.uid ||
                parentChat().doctorUid == request.auth.uid
              );
          }

          allow read: if messageParticipant() || hasPermission(hospitalId, "messages", "view");
          allow create: if messageParticipant() &&
            parentChat().status == "open" &&
            request.resource.data.senderUid == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }

    // Legacy public data used by the existing website. Writes are now admin-only.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /blogCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /departments/{departmentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /locations/{locationId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /consultationQueries/{queryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /feedback/{feedbackId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    // Existing root collections kept for backward compatibility during migration.
    match /staff/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /patients/{patientId} {
      allow create: if signedIn() && request.auth.uid == patientId;
      allow read, update: if signedIn() && (request.auth.uid == patientId || isAdmin());
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if signedIn() && (request.auth.uid == vendorId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if signedIn();
      allow read, update: if signedIn() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.doctorUid == request.auth.uid ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /testBookings/{bookingId} {
      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.patientUid == request.auth.uid ||
        hasPermission(request.resource.data.hospitalId, "testBookings", "create")
      );
      allow read: if isAdmin() ||
        (
          signedIn() &&
          (
            resource.data.userId == request.auth.uid ||
            resource.data.patientUid == request.auth.uid ||
            hasPermission(resource.data.hospitalId, "testBookings", "view")
          )
        );
      allow update: if isAdmin() || hasPermission(resource.data.hospitalId, "testBookings", "update");
      allow delete: if isAdmin() || hasPermission(resource.data.hospitalId, "testBookings", "delete");
    }

    match /patientDocuments/{documentId} {
      allow create: if signedIn();
      allow read, update, delete: if signedIn() && (
        resource.data.patientUid == request.auth.uid ||
        isAdmin()
      );
    }

    match /notifications/{notificationId} {
      allow read, update: if signedIn() && (
        resource.data.userUid == request.auth.uid ||
        resource.data.doctorUid == request.auth.uid ||
        isAdmin()
      );
      allow create, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
