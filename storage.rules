rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/(default)/documents/users/$(uid);
    }

    function signedUserExists() {
      return signedIn() && firestore.exists(userPath(request.auth.uid));
    }

    function signedUser() {
      return firestore.get(userPath(request.auth.uid)).data;
    }

    function isAdmin() {
      return signedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == "admin" ||
          (
            signedUserExists() &&
            (
              signedUser().role == "admin" ||
              signedUser().is_superuser == true ||
              (
                signedUser().roles is list &&
                signedUser().roles.hasAny(["admin"])
              )
            )
          )
        );
    }

    function memberPath(hospitalId, uid) {
      return /databases/(default)/documents/hospitals/$(hospitalId)/members/$(uid);
    }

    function isHospitalMember(hospitalId) {
      return signedIn() &&
        (
          isAdmin() ||
          (
            firestore.exists(memberPath(hospitalId, request.auth.uid)) &&
            firestore.get(memberPath(hospitalId, request.auth.uid)).data.active == true
          )
        );
    }

    function hasPermission(hospitalId, module, action) {
      return isAdmin() ||
        (
          isHospitalMember(hospitalId) &&
          firestore.get(memberPath(hospitalId, request.auth.uid)).data.permissions is map &&
          module in firestore.get(memberPath(hospitalId, request.auth.uid)).data.permissions.keys() &&
          firestore.get(memberPath(hospitalId, request.auth.uid)).data.permissions[module] is list &&
          firestore.get(memberPath(hospitalId, request.auth.uid)).data.permissions[module].hasAny([action])
        );
    }

    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /legacy-uploads/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /hospitals/{hospitalId}/public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission(hospitalId, "hospital", "update");
    }

    match /hospitals/{hospitalId}/media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() || hasPermission(hospitalId, "media", "create") || hasPermission(hospitalId, "media", "update");
    }

    match /hospitals/{hospitalId}/patients/{patientUid}/{allPaths=**} {
      allow read, write: if signedIn() &&
        (
          request.auth.uid == patientUid ||
          isAdmin() ||
          hasPermission(hospitalId, "emr", "view") ||
          hasPermission(hospitalId, "patients", "update")
        );
    }

    match /hospitals/{hospitalId}/staff/{staffUid}/{allPaths=**} {
      allow read: if isHospitalMember(hospitalId);
      allow write: if signedIn() &&
        (
          request.auth.uid == staffUid ||
          isAdmin() ||
          hasPermission(hospitalId, "staff", "update")
        );
    }

    match /hospitals/{hospitalId}/inventory/{allPaths=**} {
      allow read: if hasPermission(hospitalId, "inventory", "view");
      allow write: if hasPermission(hospitalId, "inventory", "update");
    }

    match /hospitals/{hospitalId}/messages/{chatId}/{allPaths=**} {
      allow read, write: if isHospitalMember(hospitalId);
    }

    // Legacy paths kept readable/writable enough for the current app while migration happens.
    match /patients/{userId}/{allPaths=**} {
      allow read, write: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /staff/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
